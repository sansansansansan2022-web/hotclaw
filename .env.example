# Database
# Dev (SQLite, zero setup):
DATABASE_URL=sqlite+aiosqlite:///./hotclaw.db
# Prod (PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hotclaw

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM API
LLM_API_KEY=your-api-key-here
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o-mini

# App
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# Log
LOG_LEVEL=INFO

# Timeouts (seconds)
AGENT_TIMEOUT=120
SKILL_TIMEOUT=60
LLM_TIMEOUT=60

# Runtime research skills
ENABLE_GITHUB_SKILL=false
ENABLE_SCHOLAR_SKILL=false
ENABLE_NEWS_FEED_SOURCE=true
SKILL_CACHE_TTL_SECONDS=21600

# GitHub skill
GITHUB_API_MODE=rest
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_SKILL_TIMEOUT_SECONDS=20
GITHUB_TOKEN=
NEWS_FEED_TIMEOUT_SECONDS=15
NEWS_FEED_MAX_RESULTS_PER_QUERY=6
WECHAT_ARTICLE_SEARCH_TIMEOUT_SECONDS=15

# Scholar skill
# Supported provider tokens: openalex, crossref, semanticscholar, pubmed
SCHOLAR_PROVIDER=openalex+crossref+semanticscholar+pubmed
SCHOLAR_SKILL_TIMEOUT_SECONDS=20
OPENALEX_BASE_URL=https://api.openalex.org
OPENALEX_API_KEY=
OPENALEX_MAILTO=
CROSSREF_BASE_URL=https://api.crossref.org
CROSSREF_API_KEY=
CROSSREF_MAILTO=
SEMANTIC_SCHOLAR_BASE_URL=https://api.semanticscholar.org
SEMANTIC_SCHOLAR_API_KEY=
