# HotClaw DevBox Environment Variables
# Copy this file to .env.local and modify as needed

# ===========================================
# DATABASE (Required for production)
# ===========================================
# SQLite (Development only - data lost on container restart)
DATABASE_URL=sqlite+aiosqlite:///./hotclaw.db

# PostgreSQL (Production - recommended)
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/hotclaw

# ===========================================
# REDIS (Optional - for caching)
# ===========================================
REDIS_URL=redis://localhost:6379/0

# ===========================================
# LLM API (Required)
# ===========================================
# OpenAI
# LLM_API_KEY=sk-xxxxx
# LLM_API_BASE_URL=https://api.openai.com/v1
# LLM_MODEL_NAME=gpt-4o-mini

# DeepSeek
# LLM_API_KEY=sk-xxxxx
# LLM_API_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL_NAME=deepseek-chat

# ===========================================
# APP SETTINGS
# ===========================================
APP_ENV=production
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Timeouts (seconds)
AGENT_TIMEOUT=120
SKILL_TIMEOUT=60
LLM_TIMEOUT=60

# ===========================================
# DEVBOX SPECIFIC
# ===========================================
# Frontend build mode: auto (build first, fallback to dev) | dev | start
HOTCLAW_FRONTEND_MODE=auto

# Scheduler: 0 = disabled, 1 = enabled
HOTCLAW_ENABLE_SCHEDULER=0

# Internal ports (usually don't need to change)
HOTCLAW_BACKEND_PORT=8000
HOTCLAW_FRONTEND_PORT=3000

# Auto-create database tables on startup
HOTCLAW_AUTO_CREATE_TABLES=1

# ===========================================
# SKILLS (Optional)
# ===========================================
ENABLE_GITHUB_SKILL=false
ENABLE_SCHOLAR_SKILL=false
SKILL_CACHE_TTL_SECONDS=21600
